# Strava MCP — Vercel + Upstash port. Copy this to .env.local for local dev.

# Upstash Redis (replaces Cloudflare KV).
# Vercel Marketplace's "Upstash for Redis" sets these automatically on install.
# Locally, copy from https://console.upstash.com/redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Strava OAuth app — same as upstream.
# Register at https://www.strava.com/settings/api.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://strava-mcp.vercel.app/callback

# Optional — upstream features kept intact.
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_CALLBACK_URL=https://strava-mcp.vercel.app/webhook
POKE_API_KEY=
