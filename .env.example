# Strava MCP — Vercel + Upstash port. Copy this to .env.local for local dev.

# Upstash Redis (replaces Cloudflare KV).
#
# Vercel Marketplace's "Upstash for Redis" integration sets these automatically
# when you run `vercel integration add upstash/upstash-kv`. They land in
# .env.local via the env pull at the end of that command.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional fallback names — the code reads KV_REST_API_* first, then these.
# Useful if you wire Upstash directly (outside the Vercel integration).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Strava OAuth app — same as upstream.
# Register at https://www.strava.com/settings/api.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://strava-mcp.vercel.app/callback

# Optional — upstream features kept intact.
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_CALLBACK_URL=https://strava-mcp.vercel.app/webhook
POKE_API_KEY=
